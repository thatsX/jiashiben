* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Microsoft YaHei", sans-serif;
  background: #2a2a2a;
  display: flex;
  justify-content: center;
  min-height: 100vh;
}

#app {
  width: 400px;
  height: 100vh;
  background: #fdf6e3;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

#status-bar {
  display: flex;
  justify-content: space-around;
  background: #333;
  color: #fff;
  padding: 8px 4px;
  font-size: 12px;
  flex-shrink: 0;
}
.stat { text-align: center; }
.stat .label { display: block; color: #aaa; font-size: 10px; }

#page-container {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
}
#page-container.no-padding { padding: 0; overflow: hidden; }

.page { display: none; }
.page.active { display: block; }

#tab-bar {
  display: flex;
  border-top: 2px solid #333;
  background: #fff;
  flex-shrink: 0;
}
.tab {
  flex: 1;
  padding: 12px 4px;
  border: none;
  background: none;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
}
.tab.active { background: #ffd54f; font-weight: bold; }

.card {
  background: #fff;
  border: 2px solid #333;
  border-radius: 8px;
  padding: 10px;
  margin-bottom: 10px;
  cursor: pointer;
}
.card:hover { background: #fffbe6; }

button {
  padding: 10px;
  font-size: 15px;
  font-weight: bold;
  border: 2px solid #333;
  border-radius: 8px;
  background: #ffd54f;
  cursor: pointer;
  font-family: inherit;
}
button:hover { background: #ffca28; }
button:disabled { background: #ccc; cursor: not-allowed; }

/* ============================================================
   首页：整页餐馆
   ============================================================ */
#page-home.active {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0;
}

#scene-restaurant {
  flex: 1;
  position: relative;
  overflow: hidden;
  background-color: #ffe6b3;
  background-image: url('assets/bg/restaurant.png');
  background-size: cover;
  background-position: center;
}

.scene-back-zone {
  position: absolute;
  left: 0; right: 0;
  top: 0;
  height: 33%;
  background: linear-gradient(to bottom,
              rgba(80, 50, 20, 0.35),
              rgba(80, 50, 20, 0.15));
  pointer-events: none;
}

.scene-divider {
  position: absolute;
  left: 0; right: 0;
  top: 33%;
  height: 4px;
  background: #6d4c2a;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  pointer-events: none;
  z-index: 1;
}

.home-bottom-bar {
  padding: 8px 12px;
  background: #fdf6e3;
  border-top: 2px solid #333;
  flex-shrink: 0;
}
.settle-btn { width: 100%; }

.scene-status-panel {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 20;
  background: rgba(255, 255, 255, 0.94);
  border: 2px solid #333;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 11px;
  line-height: 1.6;
  min-width: 130px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.scene-status-panel .row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}
.scene-status-panel .label { color: #666; }
.scene-status-panel .value { font-weight: bold; color: #333; }
.scene-status-panel .row.warn .value { color: #ff9800; }
.scene-status-panel .row.danger .value { color: #d32f2f; }

/* 右上角菜单按钮 */
.scene-menu-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 20;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: bold;
  background: #ffd54f;
  border: 2px solid #333;
  border-radius: 6px;
  cursor: pointer;
  font-family: inherit;
}
.scene-menu-btn:hover { background: #ffca28; }

.layer-tables,
.layer-chairs,
.layer-chars,
.layer-customers {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.layer-tables  { z-index: 2; }
.layer-chairs  { z-index: 3; }
.layer-customers { z-index: 4; }
.layer-chars   { z-index: 5; }

.table {
  position: absolute;
  width: 60px;
  height: 40px;
  transform: translate(-50%, -50%);
  background: #d2a679;
  border: 3px solid #8b5a2b;
  border-radius: 8px;
  box-shadow: 0 4px 0 rgba(0,0,0,0.15);
}
.table::before {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 60%; height: 4px;
  transform: translate(-50%, -50%);
  background: rgba(139, 90, 43, 0.4);
  border-radius: 2px;
}

.chair {
  position: absolute;
  width: 24px;
  height: 24px;
  transform: translate(-50%, -50%);
  background: #a0522d;
  border: 3px solid #5d2f0a;
  border-radius: 6px;
  box-shadow: 0 3px 0 rgba(0,0,0,0.15);
}

.scene-empty {
  position: absolute;
  top: 60%; left: 50%;
  transform: translate(-50%, -50%);
  color: #333;
  font-size: 13px;
  text-align: center;
  background: rgba(255,255,255,0.92);
  padding: 10px 16px;
  border-radius: 8px;
  line-height: 1.6;
  z-index: 30;
  pointer-events: none;
}

/* ============================================================
   家庭页
   ============================================================ */
#scene-home {
  position: relative;
  width: 100%;
  height: 380px;
  border: 2px solid #333;
  border-radius: 8px;
  overflow: hidden;
  background-color: #d4e6ff;
  background-image: url('assets/bg/home.png');
  background-size: cover;
  background-position: center;
}
.scene-floor {
  position: absolute;
  left: 0; right: 0;
  bottom: 0;
  height: 40%;
  background:
    repeating-linear-gradient(90deg,
      transparent 0,
      transparent 40px,
      rgba(0,0,0,0.05) 40px,
      rgba(0,0,0,0.05) 42px);
  pointer-events: none;
}

/* ============================================================
   商店街
   ============================================================ */
#page-shop.active {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0;
}

#scene-shop {
  flex: 1;
  position: relative;
  overflow: hidden;
  background-color: #cfe3c1;
  background-image: url('assets/bg/shop.png');
  background-size: cover;
  background-position: center;
}

/* 街道（视觉装饰） */
.shop-road {
  position: absolute;
  background: #a0a0a0;
  opacity: 0.35;
  pointer-events: none;
}
.shop-road-h {
  left: 0; right: 0;
  top: 50%;
  height: 12%;
  transform: translateY(-50%);
}
.shop-road-v {
  top: 0; bottom: 0;
  left: 50%;
  width: 12%;
  transform: translateX(-50%);
}

/* 建筑方框 */
.shop-building {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 90px;
  height: 70px;
  background: #9e9e9e;
  border: 3px solid #333;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  text-align: center;
  padding: 4px;
  box-shadow: 0 4px 0 rgba(0,0,0,0.2);
  transition: transform 0.15s;
  z-index: 2;
}
.shop-building:hover {
  transform: translate(-50%, -50%) scale(1.05);
  background: #b0b0b0;
}
.shop-name {
  font-size: 13px;
  font-weight: bold;
  color: #fff;
  text-shadow: 1px 1px 0 #333;
}
.shop-count {
  font-size: 10px;
  color: #eee;
  margin-top: 4px;
}

/* 店铺弹窗 */
.shop-info {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 6px 10px;
  margin-bottom: 8px;
}

.recipe-unlock {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  padding: 5px 8px;
  border-radius: 4px;
  margin-bottom: 4px;
  background: #f0f0f0;
  color: #888;
}
.recipe-unlock.unlocked {
  background: #e8f5e9;
  color: #2e7d32;
  font-weight: bold;
}

.worker-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  background: #fff;
  border: 2px solid #ccc;
  border-radius: 8px;
  margin-bottom: 6px;
  cursor: pointer;
  transition: all 0.15s;
}
.worker-option:hover { border-color: #ffd54f; }
.worker-option.selected {
  border-color: #4caf50;
  background: #e8f5e9;
}
.worker-option.disabled {
  background: #f5f5f5;
  cursor: not-allowed;
  opacity: 0.6;
}
.worker-info { flex: 1; }
.worker-info b { font-size: 13px; }

.income-preview {
  margin-top: 12px;
  padding: 10px 12px;
  background: #fff8e1;
  border: 2px solid #ffd54f;
  border-radius: 8px;
  text-align: right;
  font-size: 14px;
}
.income-preview b {
  font-size: 18px;
  color: #d32f2f;
}

/* ============================================================
   场景小人
   ============================================================ */
.sprite {
  position: absolute;
  width: 60px;
  height: 80px;
  transform: translate(-50%, -100%);
  transition: left 3s linear, top 3s linear;
  cursor: pointer;
  text-align: center;
  pointer-events: auto;
}
.sprite:hover { filter: brightness(1.1); }

.sprite > img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  pointer-events: none;
}

.sprite-fallback {
  display: none;
  width: 100%;
  height: 100%;
  position: relative;
  pointer-events: none;
}
.sprite-fallback .fb-head {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 24px;
  background: #7a5c3e;
  border-radius: 50%;
  border: 2px solid #333;
}
.sprite-fallback .fb-body {
  position: absolute;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  width: 34px;
  height: 50px;
  background: #c98e5e;
  border-radius: 14px 14px 6px 6px;
  border: 2px solid #333;
}

.sprite-label {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -18px;
  background: rgba(0,0,0,0.65);
  color: #fff;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 8px;
  white-space: nowrap;
  pointer-events: none;
}

.sprite-energy {
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: -6px;
  height: 4px;
  background: rgba(0,0,0,0.3);
  border-radius: 2px;
  overflow: hidden;
  pointer-events: none;
}
.sprite-energy-fill {
  height: 100%;
  background: #4caf50;
  transition: width 0.3s;
}
.sprite.tired .sprite-energy-fill { background: #d32f2f; }

.sprite-rest {
  position: absolute;
  top: -22px;
  left: 50%;
  transform: translateX(-50%);
  background: #4caf50;
  color: #fff;
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  white-space: nowrap;
  pointer-events: none;
}

.customer-sprite {
  width: 50px;
  height: 66px;
  opacity: 0.95;
}
.customer-sprite .sprite-fallback .fb-head { background: #5a7aa8; }
.customer-sprite .sprite-fallback .fb-body { background: #7aa0c8; }

/* ============================================================
   头像 / 立绘
   ============================================================ */
.avatar {
  position: relative;
  display: flex;
  align-items: center; justify-content: center;
  border-radius: 50%;
  overflow: hidden;
  background: #eee;
  flex-shrink: 0;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.avatar-fallback {
  display: none; width: 100%; height: 100%;
  align-items: center; justify-content: center;
  background: #ddd; color: #666;
  font-size: 10px; text-align: center;
  padding: 2px; word-break: break-all;
}

.portrait {
  width: 130px; height: 170px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8px; background: #eee; overflow: hidden;
}
.portrait img { width: 100%; height: 100%; object-fit: contain; display: block; }
.portrait-fallback {
  display: none; width: 100%; height: 100%;
  align-items: center; justify-content: center;
  background: #ddd; color: #666; font-size: 14px;
}

/* ============================================================
   弹窗
   ============================================================ */
#modal {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  display: none;
  justify-content: center; align-items: center;
  padding: 16px; z-index: 100;
}
#modal.show { display: flex; }
#modal-box {
  background: #fdf6e3;
  border: 3px solid #333; border-radius: 12px;
  padding: 16px; width: 100%;
  max-height: 90vh; overflow-y: auto;
}
#modal-text { font-size: 14px; line-height: 1.7; }
#modal-text .speaker { font-weight: bold; color: #d32f2f; margin-right: 4px; }
#modal-text p { margin-bottom: 6px; }
#modal-btn { width: 100%; margin-top: 12px; }

.settle-top {
  border-bottom: 2px dashed #999;
  padding-bottom: 10px; margin-bottom: 12px;
}
.settle-top h3 { font-size: 16px; margin-bottom: 8px; color: #333; }
.settle-bottom { display: flex; flex-direction: column; gap: 10px; }
.portraits { display: flex; justify-content: space-around; padding: 4px 0; }
.dialogue {
  background: #fff; border: 1px solid #ddd;
  border-radius: 8px; padding: 10px;
  font-size: 13px; line-height: 1.7;
  max-height: 180px; overflow-y: auto;
}
.dialogue p { margin-bottom: 6px; }
.dialogue .speaker { font-weight: bold; color: #d32f2f; }

/* 账本 */
.ledger-row {
  display: flex; justify-content: space-between;
  font-size: 13px; padding: 3px 0;
}
.ledger-row.total {
  border-top: 1px solid #333;
  margin-top: 5px; padding-top: 6px;
  font-weight: bold; font-size: 14px;
}
.week-record {
  background: #fff; border: 1px solid #ccc;
  border-radius: 6px; padding: 8px 10px; margin-bottom: 8px;
}
.week-record-title {
  font-weight: bold; font-size: 13px;
  color: #d32f2f; margin-bottom: 4px;
}

/* 排班 */
.schedule-row {
  display: flex; align-items: center; gap: 10px;
  background: #fff; border: 1px solid #ccc;
  border-radius: 8px; padding: 8px 10px; margin-bottom: 8px;
}
.schedule-avatar { flex-shrink: 0; }
.schedule-info { flex: 1; }
.schedule-info b { font-size: 13px; }
.schedule-row select {
  padding: 6px; border: 1px solid #999;
  border-radius: 4px; font-size: 13px;
  font-family: inherit;
}
.energy-bar {
  height: 6px; background: #eee;
  border-radius: 3px; overflow: hidden;
  margin: 4px 0 2px;
}
.energy-fill {
  height: 100%; background: #4caf50;
  transition: width 0.3s;
}
.energy-fill.critical { background: #d32f2f; }

/* 菜单页 */
.recipe-item {
  display: flex; align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 2px solid #ccc;
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 8px;
  cursor: pointer;
  transition: all 0.15s;
}
.recipe-item:hover { border-color: #ffd54f; }
.recipe-item.selected {
  border-color: #4caf50;
  background: #e8f5e9;
}
.recipe-item.disabled {
  background: #f5f5f5;
  cursor: not-allowed;
  opacity: 0.6;
}
.recipe-info { flex: 1; }
.recipe-check {
  font-size: 20px; color: #4caf50;
  font-weight: bold; margin-left: 10px;
}

/* ============================================================
   家庭页：角色状态卡
   ============================================================ */
.family-status-list {
  margin-top: 4px;
}

.status-card {
  position: relative;
  display: flex;
  gap: 10px;
  background: #fff;
  border: 2px solid #333;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 10px;
  overflow: hidden;
}

.status-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-info {
  flex: 1;
  min-width: 0;
}

.status-name {
  font-size: 14px;
  margin-bottom: 5px;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.status-tag {
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 8px;
  font-weight: normal;
}
.status-tag.working {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #4caf50;
}
.status-tag.resting {
  background: #e3f2fd;
  color: #1565c0;
  border: 1px solid #2196f3;
}

.status-energy {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
}
.status-energy-bar {
  flex: 1;
  height: 6px;
  background: #eee;
  border-radius: 3px;
  overflow: hidden;
}
.status-energy-fill {
  height: 100%;
  background: #4caf50;
  transition: width 0.3s;
}
.status-card.tired .status-energy-fill {
  background: #d32f2f;
}
.status-energy-text {
  font-size: 11px;
  color: #666;
  min-width: 42px;
  text-align: right;
}

.status-line {
  font-size: 12px;
  color: #555;
  line-height: 1.55;
  margin-bottom: 1px;
  word-break: break-all;
}
.status-line b {
  color: #333;
}

/* 精力<20：灰色盖板 */
.status-overlay {
  position: absolute;
  inset: 0;
  background: rgba(70, 70, 70, 0.62);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: bold;
  letter-spacing: 3px;
  text-shadow: 1px 1px 3px #000;
  z-index: 5;
  pointer-events: none;
  backdrop-filter: blur(1px);
}

/* 对话按钮 */
.talk-btn {
  width: 100%;
  margin-top: 14px;
  padding: 10px;
  font-size: 15px;
  font-weight: bold;
  border: 2px solid #333;
  border-radius: 8px;
  background: #ffd54f;
  cursor: pointer;
  font-family: inherit;
}
.talk-btn:hover:not(:disabled) { background: #ffca28; }
.talk-btn:disabled {
  background: #ccc;
  cursor: not-allowed;
  color: #666;
}

/* 对话气泡 */
.talk-bubble {
  background: #fff;
  border: 2px solid #333;
  border-radius: 12px;
  padding: 14px 16px;
  margin-top: 8px;
  position: relative;
  font-size: 15px;
  line-height: 1.7;
  color: #333;
}
.talk-bubble::before {
  content: '';
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-bottom: 10px solid #333;
}
.talk-bubble::after {
  content: '';
  position: absolute;
  top: -7px;
  left: 50%;
  transform: translateX(-50%);
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-bottom: 8px solid #fff;
}

/* 已聊过标签 */
.status-tag.talked {
  background: #f3e5f5;
  color: #6a1b9a;
  border: 1px solid #ab47bc;
}