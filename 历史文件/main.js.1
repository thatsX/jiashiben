/* ============================================================
   main.js —— 游戏逻辑
   ============================================================ */

window.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => switchPage(tab.dataset.page));
  });
  try { init(); }
  catch (e) {
    console.error('初始化失败:', e);
    alert('初始化出错：' + e.message);
  }
});

let state = {
  week: 1,
  cash: CONFIG.startCash,
  loan: CONFIG.startLoan,
  totalProfit: 0,
  reputation: 50,
  bankruptCount: 0,
  customers: [],
  seenCustomers: [],
  ledger: [],
  menu: [],
  learnedRecipes: [],
  lastTraffic: 0,
  lastProfit: 0,
  purchaseWeeks: 0,
  lastPurchaseMul: 0,
};

function createCharacterEntity(data) {
  return {
    id: data.id,
    name: data.name,
    traits: { ...data.traits },
    skills: [...(data.skills || [])],
    positionBonus: { ...data.positionBonus },
    defaultState: { ...data.defaultState },
    current: {
      task: data.defaultState.task,
      visual: data.defaultState.visual,
      energy: data.traits.energyMax,
      affinity: 0,
      position: { x: 50, y: 70 },
      moveTimer: 0,
      workShop: null,
      talkedThisWeek: false,
    },
  };
}

let characters = CHARACTERS.map(createCharacterEntity);

// ============================================================
//   岗位合并规则
// ============================================================

// 餐厅岗位（后厨/洗碗/前台）：增益幅度直接叠加
// 例：×1.10 和 ×1.15 → 1 + 0.10 + 0.15 = 1.25
function combineRestaurantBonus(mults) {
  if (!mults || mults.length === 0) return 1;
  let sum = 0;
  mults.forEach(m => { sum += (m - 1); });
  return Math.max(0, 1 + sum);
}

// 多人时精力消耗折扣
function getPositionEnergyMultiplier(taskId) {
  const inPosition = characters.filter(c => c.current.task === taskId);
  if (inPosition.length < 2) return 1;

  if (taskId === 'kitchen' || taskId === 'wash' || taskId === 'front') {
    return 2 / 3;   // 餐厅岗位：消耗 2/3
  }
  if (taskId === 'buy') {
    return 1 / 3;   // 采购：消耗 1/3
  }
  return 1;
}

// ============================================================
//   位置
// ============================================================
function updateWorkPositions() {
  const counter = { kitchen: 0, wash: 0, front: 0 };
  characters.forEach(c => {
    const spots = RESTAURANT_SPOTS[c.current.task];
    if (spots) {
      const idx = counter[c.current.task] % spots.length;
      c.current.position = { x: spots[idx].x, y: spots[idx].y };
      counter[c.current.task]++;
    }
  });
}

function assignHomeInitialPosition(c) {
  c.current.position = {
    x: HOME_BOUNDS.xMin + Math.random() * (HOME_BOUNDS.xMax - HOME_BOUNDS.xMin),
    y: HOME_BOUNDS.yMin + Math.random() * (HOME_BOUNDS.yMax - HOME_BOUNDS.yMin),
  };
  c.current.moveTimer = 1500 + Math.random() * 2500;
}

// ============================================================
//   菜谱
// ============================================================
function getAvailableRecipes() {
  const set = new Set();
  characters.forEach(c => {
    if (c.current.task === 'kitchen') {
      c.skills.forEach(id => set.add(id));
    }
  });
  return Array.from(set);
}

function syncMenuWithKitchen() {
  const avail = getAvailableRecipes();
  state.menu = state.menu.filter(id => avail.indexOf(id) >= 0);
}

function getMenuCost() {
  const sum = state.menu.reduce((s, id) => {
    const r = RECIPES.find(x => x.id === id);
    return s + (r ? r.cost : 0);
  }, 0);
  return sum * CONFIG.menuCostMultiplier;
}

// ============================================================
//   通用组件
// ============================================================
function avatarHTML(id, folder, size) {
  size = size || 48;
  return `
    <div class="avatar" style="width:${size}px;height:${size}px">
      <img src="assets/${folder}/${id}.png"
           onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
      <div class="avatar-fallback">${id}</div>
    </div>
  `;
}

function portraitHTML(id, name) {
  return `
    <div class="portrait">
      <img src="assets/chars_full/${id}.png"
           onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
      <div class="portrait-fallback">${name}</div>
    </div>
  `;
}

function spriteInnerHTML(c, showRestLabel) {
  const energyPct = (c.current.energy / c.traits.energyMax) * 100;
  const restLabel = showRestLabel && c.current.task === 'rest'
    ? '<div class="sprite-rest">休息中</div>' : '';
  const tired = c.current.energy < 20 ? 'tired' : '';
  return {
    className: `sprite ${tired}`,
    html: `
      <img src="assets/sprites/${c.id}.png"
           onerror="this.style.display='none'; this.nextElementSibling.style.display='block'">
      <div class="sprite-fallback">
        <div class="fb-head"></div>
        <div class="fb-body"></div>
      </div>
      ${restLabel}
      <div class="sprite-label">${c.name}</div>
      <div class="sprite-energy">
        <div class="sprite-energy-fill" style="width:${energyPct}%"></div>
      </div>
    `,
  };
}

// ============================================================
//   弹窗
// ============================================================
function showModal(html) {
  document.getElementById('modal-text').innerHTML = html;
  document.getElementById('modal').classList.add('show');

  const btn = document.getElementById('modal-btn');
  btn.style.display = 'block';
  btn.textContent = '继续';
  btn.onclick = closeModal;
}
function closeModal() {
  document.getElementById('modal').classList.remove('show');
}

function playScript(script) {
  return script.map(line => {
    if (line.who) return '<p><span class="speaker">' + line.who + '：</span>' + line.say + '</p>';
    return '<p style="color:#666">' + line.text + '</p>';
  }).join('');
}

// ============================================================
//   页面切换
// ============================================================
function switchPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  const page = document.getElementById('page-' + name);
  const tab = document.querySelector('.tab[data-page="' + name + '"]');
  if (page) page.classList.add('active');
  if (tab) tab.classList.add('active');

  const container = document.getElementById('page-container');
  if (container) {
    if (name === 'home' || name === 'shop') container.classList.add('no-padding');
    else container.classList.remove('no-padding');
  }

  renderPage(name);
}

function renderPage(name) {
  const fn = {
    home: renderHome,
    family: renderFamily,
    menu: renderMenu,
    shop: renderShop,
    ledger: renderLedger,
  }[name];
  if (fn) fn();
}

function renderStatus() {
  document.getElementById('stat-week').textContent = state.week;
  document.getElementById('stat-cash').textContent = Math.round(state.cash);
  document.getElementById('stat-loan').textContent = Math.round(state.loan);
  document.getElementById('stat-profit').textContent = Math.round(state.totalProfit);
}

// ============================================================
//   首页：餐馆
// ============================================================
function renderHome() {
  const el = document.getElementById('page-home');

  const hasFront = characters.some(c => c.current.task === 'front');
  const hasKitchen = characters.some(c => c.current.task === 'kitchen');
  const hasWash = characters.some(c => c.current.task === 'wash');
  const canOperate = hasFront && hasKitchen && hasWash;

  const missing = [];
  if (!hasKitchen) missing.push('后厨');
  if (!hasWash) missing.push('洗碗');
  if (!hasFront) missing.push('前台');

  const menuBtnText = state.menu.length > 0
    ? `菜单 (${state.menu.length}/${CONFIG.menuMax})`
    : '菜单';

  const tablesHTML = TABLES.map(t =>
    `<div class="table" style="left:${t.x}%; top:${t.y}%"></div>`
  ).join('');

  const chairsHTML = CHAIRS.map(c =>
    `<div class="chair" data-chair-id="${c.id}" style="left:${c.x}%; top:${c.y}%"></div>`
  ).join('');

  let purchaseText, purchaseClass;
  if (state.purchaseWeeks >= CONFIG.purchaseGraceWeeks) {
    purchaseText = '已断采！+100%';
    purchaseClass = 'danger';
  } else if (state.purchaseWeeks === 0) {
    purchaseText = '正常（+' + Math.round(state.lastPurchaseMul * 100) + '%）';
    purchaseClass = '';
  } else {
    const remain = CONFIG.purchaseGraceWeeks - state.purchaseWeeks;
    purchaseText = remain + ' 周内需采购';
    purchaseClass = remain <= 1 ? 'warn' : '';
  }

  const rep = state.reputation;
  let repDesc = '普通小店';
  if (rep >= 80) repDesc = '座无虚席';
  else if (rep >= 60) repDesc = '小有名气';
  else if (rep < 20) repDesc = '快倒闭了';

  let previewHTML = '';
  if (canOperate && state.menu.length > 0) {
    const preview = calculateBusiness();
    previewHTML = `
      <div class="row"><span class="label">预计客流</span><span class="value">${Math.round(preview.traffic)}</span></div>
      <div class="row"><span class="label">预计净利</span><span class="value">${preview.profit >= 0 ? '+' : ''}${Math.round(preview.profit)}</span></div>
    `;
  }

  el.innerHTML = `
    <div id="scene-restaurant">
      <div class="scene-status-panel">
        <div class="row"><span class="label">信誉</span><span class="value">${rep.toFixed(1)} · ${repDesc}</span></div>
        <div class="row"><span class="label">上周客流</span><span class="value">${state.lastTraffic}</span></div>
        <div class="row"><span class="label">上周净利</span><span class="value">${state.lastProfit >= 0 ? '+' : ''}${state.lastProfit}</span></div>
        <div class="row ${purchaseClass}"><span class="label">采购</span><span class="value">${purchaseText}</span></div>
        ${previewHTML}
      </div>

      <button class="scene-menu-btn" onclick="switchPage('menu')">
        📋 ${menuBtnText}
      </button>

      <div class="scene-back-zone"></div>
      <div class="scene-divider"></div>
      <div class="layer-tables">${tablesHTML}</div>
      <div class="layer-chairs">${chairsHTML}</div>
      <div class="layer-chars" id="layer-chars"></div>
      <div class="layer-customers" id="layer-customers"></div>
      ${!canOperate ? `<div class="scene-empty">还缺：${missing.join(' / ')}<br>去「家庭」页排班吧</div>` : ''}
    </div>
    <div class="home-bottom-bar">
      <button class="settle-btn"
              ${!canOperate ? 'disabled' : ''}
              onclick="settle()">
        ${canOperate ? '营业结算' : '无法营业'}
      </button>
    </div>
  `;

  renderWorkCharsDOM();
  updateCustomersDOM();
}

function renderWorkCharsDOM() {
  const el = document.getElementById('layer-chars');
  if (!el) return;

  const workChars = characters.filter(c =>
    c.current.task === 'kitchen' ||
    c.current.task === 'wash' ||
    c.current.task === 'front'
  );

  el.innerHTML = workChars.map(c => {
    const info = spriteInnerHTML(c, false);
    return `
      <div class="${info.className}"
           data-char-id="${c.id}"
           style="left:${c.current.position.x}%; top:${c.current.position.y}%;"
           onclick="showCharStatus('${c.id}')">
        ${info.html}
      </div>
    `;
  }).join('');
}

// ============================================================
//   客人
// ============================================================
function findAvailableChair() {
  const occupied = new Set(
    state.customers.filter(c => c.chairId).map(c => c.chairId)
  );
  const free = CHAIRS.filter(ch => !occupied.has(ch.id));
  if (free.length === 0) return null;
  return free[Math.floor(Math.random() * free.length)];
}

function createCustomerFromTemplate(template, isSpecial) {
  const uid = 'c' + Date.now() + Math.random().toString(36).slice(2, 7);
  return {
    uid,
    id: template.id,
    name: template.name,
    type: template.type,
    isSpecial: !!isSpecial,
    phase: 'entering',
    chairId: null,
    position: { x: CUSTOMER_ENTRY.x, y: CUSTOMER_ENTRY.y },
    timer: 300,
  };
}

function spawnNormalCustomer() {
  const pool = CUSTOMERS.filter(c => c.type === 'normal');
  const tpl = pool[Math.floor(Math.random() * pool.length)];
  state.customers.push(createCustomerFromTemplate(tpl, false));
}

function tickCustomers(dt) {
  state.customers.forEach(c => {
    c.timer -= dt;
    if (c.timer > 0) return;

    if (c.phase === 'entering') {
      const chair = findAvailableChair();
      if (!chair) { c.timer = 1000; return; }
      c.chairId = chair.id;
      c.position = { x: chair.x, y: chair.y };
      c.phase = 'goingToChair';
      c.timer = 3200;

    } else if (c.phase === 'goingToChair') {
      c.phase = 'seated';
      c.timer = c.isSpecial ? Infinity : (8000 + Math.random() * 8000);

    } else if (c.phase === 'seated') {
      c.chairId = null;
      c.position = { x: CUSTOMER_EXIT.x, y: CUSTOMER_EXIT.y };
      c.phase = 'leaving';
      c.timer = 3500;

    } else if (c.phase === 'leaving') {
      c.phase = 'gone';
    }
  });

  state.customers = state.customers.filter(c => c.phase !== 'gone');

  const normalCount = state.customers.filter(c => !c.isSpecial).length;
  if (normalCount < 3 && state.customers.length < CHAIRS.length) {
    spawnNormalCustomer();
  }
}

function updateCustomersDOM() {
  const el = document.getElementById('layer-customers');
  if (!el) return;

  Array.from(el.children).forEach(child => {
    if (!state.customers.find(c => c.uid === child.dataset.custId)) {
      child.remove();
    }
  });

  state.customers.forEach(c => {
    let node = el.querySelector('[data-cust-id="' + c.uid + '"]');

    if (!node) {
      node = document.createElement('div');
      node.className = 'sprite customer-sprite';
      node.dataset.custId = c.uid;
      node.style.transition = 'none';
      node.style.left = c.position.x + '%';
      node.style.top = c.position.y + '%';
      node.innerHTML = `
        <img src="assets/customers/${c.id}.png"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='block'">
        <div class="sprite-fallback">
          <div class="fb-head"></div>
          <div class="fb-body"></div>
        </div>
        <div class="sprite-label">${c.name}</div>
      `;
      node.onclick = () => talkToCustomerByUid(c.uid);
      el.appendChild(node);
      void node.offsetWidth;
      node.style.transition = '';
    } else {
      node.style.left = c.position.x + '%';
      node.style.top = c.position.y + '%';
    }
  });
}

function talkToCustomerByUid(uid) {
  const c = state.customers.find(x => x.uid === uid);
  if (!c) return;
  const lines = STORY.customers[c.id];
  if (!lines) return;

  if (c.type === 'normal') {
    const line = lines[Math.floor(Math.random() * lines.length)];
    showModal('<p><span class="speaker">' + c.name + '：</span>' + line + '</p>');
    return;
  }

  showModal(playScript(lines));

  if (c.id === 'critic') state.reputation += 10;
  if (c.id === 'zhulaoban') {
    state.cash += 500;
    renderStatus();
  }
}

function generateSpecialCustomers() {
  const repFactor = Math.max(0, Math.min(2, state.reputation / 50));

  CUSTOMERS.filter(c => c.type === 'special').forEach(c => {
    if (c.minWeek && state.week < c.minWeek) return;
    if (c.once && state.seenCustomers.indexOf(c.id) >= 0) return;

    let chance = (typeof c.chance === 'number') ? c.chance : 1.0;
    chance *= repFactor;

    if (Math.random() > chance) return;

    state.customers.push(createCustomerFromTemplate(c, true));
    state.seenCustomers.push(c.id);
  });
}

// ============================================================
//   角色状态弹窗 + 对话
// ============================================================
function showCharStatus(charId) {
  const c = characters.find(x => x.id === charId);
  if (!c) return;

  const task = TASKS.find(t => t.id === c.current.task);
  let taskName;
  if (c.current.task === 'work') {
    const shop = SHOPS.find(s => s.id === c.current.workShop);
    taskName = shop ? '打工（' + shop.name + '）' : '打工';
  } else {
    taskName = task ? task.name : '无';
  }

  const zone = TASK_ZONE[c.current.task];
  const zoneText = { restaurant: '餐馆', home: '家中', outside: '外出' }[zone] || '未知';

  const skillsText = c.skills.length > 0
    ? c.skills.map(id => {
        const r = RECIPES.find(x => x.id === id);
        return r ? r.name : id;
      }).join('、')
    : '（不会做菜）';

  const canTalk = !c.current.talkedThisWeek;

  const pb = c.positionBonus;
  const bonusHTML = `
    <div class="ledger-row"><span>后厨加成</span><span>×${pb.kitchen.toFixed(2)}</span></div>
    <div class="ledger-row"><span>洗碗加成</span><span>×${pb.wash.toFixed(2)}</span></div>
    <div class="ledger-row"><span>前台加成</span><span>×${pb.front.toFixed(2)}</span></div>
    <div class="ledger-row"><span>采购上涨</span><span>+${(pb.buy * 100).toFixed(0)}%</span></div>
  `;

  showModal(`
    <div style="text-align:center;margin-bottom:12px">
      ${avatarHTML(c.id, 'chars', 64)}
      <h3 style="margin-top:6px">${c.name}</h3>
      <p style="color:#888;font-size:12px">好感 ${c.current.affinity}</p>
    </div>
    <div class="ledger-row"><span>当前任务</span><span>${taskName}</span></div>
    <div class="ledger-row"><span>所在位置</span><span>${zoneText}</span></div>
    <div class="ledger-row"><span>精力</span><span>${Math.round(c.current.energy)} / ${c.traits.energyMax}</span></div>
    <div class="ledger-row" style="align-items:flex-start">
      <span>会做的菜</span>
      <span style="text-align:right;max-width:60%">${skillsText}</span>
    </div>
    <h4 style="margin-top:10px;font-size:13px">岗位加成</h4>
    ${bonusHTML}

    <button class="talk-btn"
            ${!canTalk ? 'disabled' : ''}
            onclick="talkToChar('${c.id}')">
      ${canTalk ? '💬 聊聊天（+5 好感）' : '本周已聊过'}
    </button>
  `);
  document.getElementById('modal-btn').textContent = '关闭';
}

function talkToChar(charId) {
  const c = characters.find(x => x.id === charId);
  if (!c) return;
  if (c.current.talkedThisWeek) {
    alert(c.name + ' 本周已经聊过了。');
    return;
  }

  c.current.talkedThisWeek = true;
  c.current.affinity += 5;

  const lines = STORY.talk[c.name] || ['……'];
  const line = lines[Math.floor(Math.random() * lines.length)];

  showModal(`
    <div style="text-align:center;margin-bottom:12px">
      ${avatarHTML(c.id, 'chars', 64)}
      <h3 style="margin-top:6px">${c.name}</h3>
    </div>
    <div class="talk-bubble">
      <p>“${line}”</p>
    </div>
    <p style="text-align:center;color:#4caf50;font-size:13px;margin-top:12px;font-weight:bold">
      好感 +5（当前 ${c.current.affinity}）
    </p>
  `);
  document.getElementById('modal-btn').textContent = '关闭';

  const active = document.querySelector('.page.active');
  if (active && active.id === 'page-family') {
    renderFamily();
  }
}

// ============================================================
//   家庭页
// ============================================================
function renderFamily() {
  const el = document.getElementById('page-family');

  const homeChars = characters.filter(c => TASK_ZONE[c.current.task] === 'home');
  homeChars.forEach(c => {
    if (!c.current.moveTimer || c.current.moveTimer <= 0) {
      assignHomeInitialPosition(c);
    }
  });

  const statusListHTML = characters.map(c => renderStatusCard(c)).join('');

  el.innerHTML = `
    <button style="width:100%;margin-bottom:12px" onclick="openSchedule()">
      📋 排班系统
    </button>
    <div id="scene-home">
      <div class="scene-floor"></div>
      <div id="scene-home-chars"></div>
      ${homeChars.length === 0 ? '<div class="scene-empty">大家都在外面忙……</div>' : ''}
    </div>
    <h3 style="margin-top:16px">家庭成员状态</h3>
    <div class="family-status-list">
      ${statusListHTML}
    </div>
  `;

  updateHomeCharsDOM();
}

function renderStatusCard(c) {
  const isTired = c.current.energy < 20;
  const energyPct = (c.current.energy / c.traits.energyMax) * 100;

  const skillsText = c.skills.length > 0
    ? c.skills.map(id => {
        const r = RECIPES.find(x => x.id === id);
        return r ? r.name : id;
      }).join('、')
    : '（暂时不会做菜）';

  const talentText = (typeof TALENT !== 'undefined' && TALENT[c.id]) ? TALENT[c.id] : '—';

  let workTag = '';
  if (c.current.task === 'work') {
    const shop = SHOPS.find(s => s.id === c.current.workShop);
    workTag = `<span class="status-tag working">打工中${shop ? ' · ' + shop.name : ''}</span>`;
  } else if (c.current.task === 'rest') {
    workTag = `<span class="status-tag resting">休息中</span>`;
  }

  const talkTag = c.current.talkedThisWeek
    ? '<span class="status-tag talked">已聊过</span>'
    : '';

  return `
    <div class="status-card ${isTired ? 'tired' : ''}"
         onclick="showCharStatus('${c.id}')">
      <div class="status-avatar">
        ${avatarHTML(c.id, 'chars', 52)}
      </div>
      <div class="status-info">
        <div class="status-name">
          <b>${c.name}</b>
          ${workTag}
          ${talkTag}
        </div>

        <div class="status-energy">
          <div class="status-energy-bar">
            <div class="status-energy-fill" style="width:${energyPct}%"></div>
          </div>
          <span class="status-energy-text">${Math.round(c.current.energy)}/${c.traits.energyMax}</span>
        </div>

        <div class="status-line"><b>会做：</b>${skillsText}</div>
        <div class="status-line"><b>擅长：</b>${talentText}</div>
      </div>

      ${isTired ? '<div class="status-overlay">已壮烈躺平</div>' : ''}
    </div>
  `;
}

function updateHomeCharsDOM() {
  const el = document.getElementById('scene-home-chars');
  if (!el) return;

  const homeChars = characters.filter(c => TASK_ZONE[c.current.task] === 'home');

  Array.from(el.children).forEach(child => {
    if (!homeChars.find(c => c.id === child.dataset.charId)) {
      child.remove();
    }
  });

  homeChars.forEach(c => {
    let node = el.querySelector('[data-char-id="' + c.id + '"]');
    if (!node) {
      const info = spriteInnerHTML(c, true);
      node = document.createElement('div');
      node.className = info.className;
      node.dataset.charId = c.id;
      node.style.left = c.current.position.x + '%';
      node.style.top = c.current.position.y + '%';
      node.innerHTML = info.html;
      node.onclick = () => showCharStatus(c.id);
      el.appendChild(node);
    } else {
      node.style.left = c.current.position.x + '%';
      node.style.top = c.current.position.y + '%';
    }
  });
}

function tickHomeChars(dt) {
  const homeChars = characters.filter(c => TASK_ZONE[c.current.task] === 'home');
  homeChars.forEach(c => {
    c.current.moveTimer -= dt;
    if (c.current.moveTimer <= 0) {
      c.current.position = {
        x: HOME_BOUNDS.xMin + Math.random() * (HOME_BOUNDS.xMax - HOME_BOUNDS.xMin),
        y: HOME_BOUNDS.yMin + Math.random() * (HOME_BOUNDS.yMax - HOME_BOUNDS.yMin),
      };
      c.current.moveTimer = 2000 + Math.random() * 3000;
    }
  });
}

function openSchedule() {
  const rows = characters.map(c => {
    const isWorking = c.current.task === 'work';
    const shop = isWorking ? SHOPS.find(s => s.id === c.current.workShop) : null;
    const energyPct = (c.current.energy / c.traits.energyMax) * 100;
    const isTired = c.current.energy < 20;
    const criticalClass = isTired ? 'critical' : '';

    let controlHTML;
    if (isWorking) {
      controlHTML = `
        <div class="work-locked">
          <div style="font-weight:bold;color:#4caf50">打工中</div>
          <div style="font-size:11px;color:#666">${shop ? shop.name : ''}</div>
        </div>
      `;
    } else {
      const taskOptions = TASKS.map(t => {
        const disabled = (t.id === 'front' || t.id === 'buy') && !c.traits.canExpose;
        const selected = c.current.task === t.id;
        return '<option value="' + t.id + '" ' +
               (selected ? 'selected' : '') + ' ' +
               (disabled ? 'disabled' : '') + '>' + t.name + '</option>';
      }).join('');
      controlHTML = `<select onchange="changeTask('${c.id}', this.value)">${taskOptions}</select>`;
    }

    return `
      <div class="schedule-row">
        <div class="schedule-avatar">${avatarHTML(c.id, 'chars', 40)}</div>
        <div class="schedule-info">
          <div><b>${c.name}</b></div>
          <div class="energy-bar">
            <div class="energy-fill ${criticalClass}" style="width:${energyPct}%"></div>
          </div>
          <div style="font-size:11px;color:#888">精力 ${Math.round(c.current.energy)}/${c.traits.energyMax}</div>
        </div>
        ${controlHTML}
      </div>
    `;
  }).join('');

  showModal(`
    <h3 style="margin-bottom:12px">家庭成员排班</h3>
    ${rows}
    <p style="font-size:12px;color:#888;margin-top:12px">
      提示：餐馆需要同时有 后厨 / 洗碗 / 前台 才能营业。<br>
      打工请去「商店街」页。要取消打工请到对应店铺点击角色。
    </p>
  `);
  document.getElementById('modal-btn').textContent = '关闭';
}

function changeTask(charId, taskId) {
  const c = characters.find(x => x.id === charId);
  if (!c) return;
  if (c.current.task === 'work') return;

  if (c.current.energy < 20 && taskId !== 'rest') {
    alert(c.name + ' 精力太低，本周只能休息。');
    openSchedule();
    return;
  }

  const oldTask = c.current.task;
  c.current.task = taskId;
  c.current.workShop = null;

  updateWorkPositions();
  if (TASK_ZONE[taskId] === 'home' && TASK_ZONE[oldTask] !== 'home') {
    assignHomeInitialPosition(c);
  }
  syncMenuWithKitchen();

  openSchedule();
  renderPage('family');
}

