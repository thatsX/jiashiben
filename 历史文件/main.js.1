// ============================================================
//   营业结算
// ============================================================
function settle() {
  const hasFront = characters.some(c => c.current.task === 'front');
  const hasKitchen = characters.some(c => c.current.task === 'kitchen');
  const hasWash = characters.some(c => c.current.task === 'wash');

  if (!hasFront || !hasKitchen || !hasWash) {
    alert('无法营业：需要同时有 后厨 / 洗碗 / 前台。');
    return;
  }
  if (state.menu.length === 0) {
    alert('菜单是空的，没法营业。去「菜单」页面选菜。');
    return;
  }

  // ===== 采购追踪 =====
  const buyers = characters.filter(c => c.current.task === 'buy');
  if (buyers.length > 0) {
    state.purchaseWeeks = 0;
    // 取最小减益
    const bestMul = Math.min.apply(null, buyers.map(c => c.positionBonus.buy));
    state.lastPurchaseMul = bestMul;
  } else {
    state.purchaseWeeks++;
  }

  // ===== 宁月打工特殊事件 =====
  let ningetsuExtraMoney = 0;
  let ningetsuWantRecipe = false;
  let ningetsuEventType = null;   // 'recipe' / 'money' / null

  const ningetsu = characters.find(c => c.id === 'ningetsu');
  if (ningetsu && ningetsu.current.task === 'work' && ningetsu.current.workShop) {
    if (Math.random() < 0.5) {
      if (Math.random() < 0.5) {
        ningetsuWantRecipe = true;
        ningetsuEventType = 'recipe';
      } else {
        const shop = SHOPS.find(s => s.id === ningetsu.current.workShop);
        if (shop) {
          ningetsuExtraMoney = shop.baseWage * ningetsu.traits.workMultiplier;
          ningetsuEventType = 'money';
        }
      }
    }
  }

  // ===== 计算经营 =====
  const r = calculateBusiness();
  r.cashChange += ningetsuExtraMoney;
  r.workIncome += ningetsuExtraMoney;

  state.cash += r.cashChange;
  state.totalProfit += r.profit;
  const settledWeek = state.week;
  state.week++;

  state.lastTraffic = Math.round(r.traffic);
  state.lastProfit = Math.round(r.profit);

  // 声誉变化
  let repChange = (r.kitchenMul - 1.0) * CONFIG.repKitchenWeight - CONFIG.repDecay;
  repChange = Math.round(repChange * 10) / 10;
  state.reputation += repChange;
  state.reputation = Math.max(0, Math.min(100, state.reputation));

  // 重置对话
  characters.forEach(c => { c.current.talkedThisWeek = false; });

  // ===== 精力扣除 =====
  characters.forEach(c => {
    if (c.current.task === 'rest') {
      c.current.energy = Math.min(c.traits.energyMax, c.current.energy + 30);
    } else if (c.current.task === 'work') {
      const shop = SHOPS.find(s => s.id === c.current.workShop);
      const cost = shop ? shop.energyCost : 40;
      c.current.energy = Math.max(0, c.current.energy - cost + c.traits.recovery * 0.5);
    } else {
      const task = TASKS.find(t => t.id === c.current.task);
      if (task) {
        const mult = getPositionEnergyMultiplier(c.current.task);
        const cost = task.energyCost * mult;
        c.current.energy = Math.max(0, c.current.energy - cost + c.traits.recovery * 0.5);
      }
    }
  });

  // ===== 店铺打工次数 + 新菜谱 =====
  const shopsUsed = new Set();
  characters.forEach(c => {
    if (c.current.task === 'work' && c.current.workShop) shopsUsed.add(c.current.workShop);
  });

  const newRecipes = [];
  shopsUsed.forEach(shopId => {
    const shop = SHOPS.find(s => s.id === shopId);
    if (!shop) return;
    shop.workCount++;
    shop.recipes.forEach((rid, i) => {
      const need = shop.unlockAt[i];
      if (shop.workCount >= need && state.learnedRecipes.indexOf(rid) < 0) {
        state.learnedRecipes.push(rid);
        newRecipes.push(rid);
      }
    });
  });

  // 宁月菜谱事件
  if (ningetsuWantRecipe) {
    const pool = RECIPES.filter(rec =>
      state.learnedRecipes.indexOf(rec.id) < 0 &&
      newRecipes.indexOf(rec.id) < 0
    );
    if (pool.length > 0) {
      const picked = pool[Math.floor(Math.random() * pool.length)];
      state.learnedRecipes.push(picked.id);
      newRecipes.push(picked.id);
    }
  }

  // ===== 写账本 =====
  state.ledger.push({
    week: settledWeek,
    revenue: Math.round(r.revenue),
    foodCost: Math.round(r.foodCost),
    fixedCost: Math.round(r.fixedCost),
    familyCost: Math.round(r.familyCost),
    workIncome: Math.round(r.workIncome),
    cashChange: Math.round(r.cashChange),
    cashAfter: Math.round(state.cash),
    profit: Math.round(r.profit),
  });

  // ===== 结算剧本 =====
  let script;
  if (r.profit > 20000) script = STORY.settlement.big;
  else if (r.profit > 0) script = STORY.settlement.small;
  else if (r.profit > -5000) script = STORY.settlement.slightLoss;
  else script = STORY.settlement.bigLoss;

  const tired = characters.find(c => c.current.energy < 20);
  if (tired && STORY.tired[tired.id]) {
    script = script.concat([{ text: '———' }], STORY.tired[tired.id]);
  }

  const settleData = {
    week: settledWeek, r, script, repChange,
    ningetsuEventType, ningetsuExtraMoney,
  };

  if (newRecipes.length > 0) {
    startLearnFlow(newRecipes, settleData);
  } else {
    showSettlementDialogue(settleData);
  }

  renderStatus();
}

function showSettlementDialogue(settleData) {
  const { week, r, script, repChange, ningetsuEventType, ningetsuExtraMoney } = settleData;
  showModal(buildSettleHTML(week, r, script, repChange, ningetsuEventType, ningetsuExtraMoney));
  document.getElementById('modal-btn').onclick = () => {
    closeModal();
    checkEnding();
  };
}

// ============================================================
//   学菜谱流程
// ============================================================
let learnQueue = [];
let learnCurrentRecipe = null;
let learnSelected = [];
let pendingSettleData = null;

function startLearnFlow(recipeIds, settleData) {
  pendingSettleData = settleData;
  learnQueue = recipeIds.slice();
  nextLearnStep();
}

function nextLearnStep() {
  if (learnQueue.length === 0) {
    learnCurrentRecipe = null;
    learnSelected = [];
    const data = pendingSettleData;
    pendingSettleData = null;
    showSettlementDialogue(data);
    return;
  }
  learnCurrentRecipe = learnQueue.shift();
  learnSelected = [];
  renderLearnModal();
}

function renderLearnModal() {
  const recipe = RECIPES.find(r => r.id === learnCurrentRecipe);
  const remaining = learnQueue.length;

  const charsHTML = characters.map(c => {
    const selected = learnSelected.indexOf(c.id) >= 0;
    const knows = c.skills.indexOf(learnCurrentRecipe) >= 0;

    let cls = 'worker-option';
    let click = `onclick="toggleLearnSelect('${c.id}')"`;
    let hint = '';

    if (knows) {
      cls += ' disabled';
      click = '';
      hint = '<span style="color:#888;font-size:11px">（已经会了）</span>';
    } else if (selected) {
      cls += ' selected';
    }

    return `
      <div class="${cls}" ${click}>
        ${avatarHTML(c.id, 'chars', 36)}
        <div class="worker-info">
          <div><b>${c.name}</b> ${hint}</div>
          <div style="font-size:11px;color:#666">精力 ${Math.round(c.current.energy)}/${c.traits.energyMax}</div>
        </div>
        ${selected ? '<div style="color:#4caf50;font-weight:bold;font-size:18px">✔</div>' : ''}
      </div>
    `;
  }).join('');

  const confirmDisabled = learnSelected.length !== 2;

  showModal(`
    <div style="text-align:center;margin-bottom:16px">
      <div style="font-size:44px">🎉</div>
      <h2 style="color:#d32f2f;margin-top:6px;font-size:20px">恭喜获得菜谱！</h2>
      <h3 style="margin-top:8px;color:#333;font-size:18px">${recipe ? recipe.name : ''}</h3>
      <p style="font-size:12px;color:#888;margin-top:6px">
        ${recipe ? `${recipe.category} · 成本 ${recipe.cost} · 售价 ${recipe.price} · 吸引力 ${recipe.appeal}` : ''}
      </p>
      ${remaining > 0 ? `<p style="font-size:11px;color:#666;margin-top:8px">（还有 ${remaining} 道菜谱待学习）</p>` : ''}
    </div>

    <p style="font-size:13px;margin-bottom:10px;text-align:center">
      选择 <b>2 人</b> 学会制作它（已选 ${learnSelected.length}/2）
    </p>
    ${charsHTML}

    <button id="learn-confirm-btn"
            style="width:100%;margin-top:12px"
            ${confirmDisabled ? 'disabled' : ''}
            onclick="confirmLearn()">
      ${confirmDisabled ? '请选择 2 人' : '确认学习'}
    </button>
  `);

  document.getElementById('modal-btn').style.display = 'none';
}

function toggleLearnSelect(charId) {
  const c = characters.find(x => x.id === charId);
  if (!c) return;
  if (c.skills.indexOf(learnCurrentRecipe) >= 0) return;

  const idx = learnSelected.indexOf(charId);
  if (idx >= 0) {
    learnSelected.splice(idx, 1);
  } else {
    if (learnSelected.length >= 2) return;
    learnSelected.push(charId);
  }
  renderLearnModal();
}

function confirmLearn() {
  if (learnSelected.length !== 2) return;
  learnSelected.forEach(cid => {
    const c = characters.find(x => x.id === cid);
    if (c && c.skills.indexOf(learnCurrentRecipe) < 0) {
      c.skills.push(learnCurrentRecipe);
    }
  });
  nextLearnStep();
}

