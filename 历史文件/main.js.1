function buildSettleHTML(week, r, script, repChange, ningetsuEventType, ningetsuExtraMoney) {
  let purchaseLine = '';
  if (state.purchaseWeeks >= CONFIG.purchaseGraceWeeks) {
    purchaseLine = `<div class="ledger-row" style="color:#d32f2f"><span>采购</span><span>断采！成本 &amp; 家庭开销 +100%</span></div>`;
  } else if (state.purchaseWeeks === 0) {
    const pct = Math.round(state.lastPurchaseMul * 100);
    purchaseLine = `<div class="ledger-row" style="color:#4caf50"><span>采购</span><span>刚采购（+${pct}%）</span></div>`;
  } else {
    const remain = CONFIG.purchaseGraceWeeks - state.purchaseWeeks;
    const pct = Math.round(state.lastPurchaseMul * 100);
    purchaseLine = `<div class="ledger-row" style="color:#ff9800"><span>采购</span><span>剩 ${remain} 周（+${pct}%）</span></div>`;
  }

  const repChangeText = repChange >= 0 ? '+' + repChange : '' + repChange;
  const repColor = repChange >= 0 ? '#4caf50' : '#d32f2f';

  // 宁月特殊事件提示
  let ningetsuLine = '';
  if (ningetsuEventType === 'money') {
    ningetsuLine = `<div class="ledger-row" style="color:#d32f2f"><span>宁月打工</span><span>意外收获！双倍工钱 +${Math.round(ningetsuExtraMoney)}</span></div>`;
  } else if (ningetsuEventType === 'recipe') {
    ningetsuLine = `<div class="ledger-row" style="color:#7b1fa2"><span>宁月打工</span><span>偷偷学到了一道新菜谱！</span></div>`;
  }

  const topHTML = `
    <div class="settle-top">
      <h3>第 ${week} 周 结算</h3>
      <div class="ledger-row"><span>客流</span><span>${Math.round(r.traffic)}</span></div>
      <div class="ledger-row"><span>客单价</span><span>${r.unitPrice.toFixed(2)}</span></div>
      <div class="ledger-row"><span>营业额</span><span>${Math.round(r.revenue)}</span></div>
      <div class="ledger-row"><span>食材成本</span><span>-${Math.round(r.foodCost)}</span></div>
      <div class="ledger-row"><span>店铺固定</span><span>-${Math.round(r.fixedCost)}</span></div>
      <div class="ledger-row"><span>家庭开销</span><span>-${Math.round(r.familyCost)}</span></div>
      <div class="ledger-row"><span>打工收入</span><span>+${Math.round(r.workIncome)}</span></div>
      ${purchaseLine}
      ${ningetsuLine}
      <div class="ledger-row total">
        <span>现金变化</span>
        <span>${r.cashChange >= 0 ? '+' : ''}${Math.round(r.cashChange)}</span>
      </div>
      <div class="ledger-row">
        <span>声誉变化</span>
        <span style="color:${repColor};font-weight:bold">${repChangeText}（当前 ${state.reputation.toFixed(1)}）</span>
      </div>
    </div>
  `;

  const bottomHTML = `
    <div class="settle-bottom">
      <div class="portraits">
        ${portraitHTML('leye', '蕾叶')}
        ${portraitHTML('kokono', '心玖')}
      </div>
      <div class="dialogue">${playScript(script)}</div>
    </div>
  `;

  return topHTML + bottomHTML;
}

function calculateBusiness() {
  const menuRecipes = state.menu
    .map(id => RECIPES.find(r => r.id === id))
    .filter(Boolean);

  // ===== 餐厅岗位：增益直接叠加 =====
  const kitchenChars = characters.filter(c => c.current.task === 'kitchen');
  const kitchenMul = combineRestaurantBonus(kitchenChars.map(c => c.positionBonus.kitchen));

  const washChars = characters.filter(c => c.current.task === 'wash');
  const washMul = combineRestaurantBonus(washChars.map(c => c.positionBonus.wash));

  const frontChars = characters.filter(c => c.current.task === 'front');
  const frontMul = combineRestaurantBonus(frontChars.map(c => c.positionBonus.front));

  // ===== 菜单平均单价 =====
  const avgPrice = menuRecipes.length > 0
    ? menuRecipes.reduce((s, r) => s + r.price, 0) / menuRecipes.length
    : 0;

  // ===== 声誉系数 =====
  const repCoeff = 1 + (state.reputation - 50) * 0.006;

  // ===== 单价系数 =====
  const priceCoeff = Math.max(
    CONFIG.priceCoeffMin,
    1 - (avgPrice - CONFIG.priceCoeffBase) * CONFIG.priceCoeffRate
  );

  // ===== 菜单种类系数 =====
  const menuCount = menuRecipes.length;
  const menuTrafficCoeff = 1 + (menuCount - 1) * CONFIG.menuCountTrafficRate;
  const menuPriceCoeff   = 1 + (menuCount - 1) * CONFIG.menuCountPriceRate;

  // ===== 客流 =====
  let traffic = CONFIG.baseTraffic;
  traffic *= repCoeff;
  traffic *= washMul;
  traffic *= priceCoeff;
  traffic *= menuTrafficCoeff;

  // ===== 客单价 =====
  const unitPrice = avgPrice * frontMul * menuPriceCoeff;

  // ===== 营业额 =====
  const revenue = traffic * unitPrice;

  // ===== 成本率 =====
  const avgCostRate = menuRecipes.length > 0
    ? menuRecipes.reduce((s, r) => s + r.cost, 0)
      / menuRecipes.reduce((s, r) => s + r.price, 0)
    : 0;

  // ===== 采购倍率 =====
  let purchaseMul;
  if (state.purchaseWeeks >= CONFIG.purchaseGraceWeeks) {
    purchaseMul = 1 + CONFIG.purchasePenalty;
  } else {
    purchaseMul = 1 + state.lastPurchaseMul;
  }

  const foodCost = revenue * avgCostRate * purchaseMul;
  const fixedCost = CONFIG.rent + CONFIG.utility + state.loan * CONFIG.loanRate;
  const familyCost = CONFIG.familyCost * purchaseMul;

  // ===== 打工收入 =====
  let workIncome = 0;
  characters.forEach(c => {
    if (c.current.task === 'work' && c.current.workShop) {
      const shop = SHOPS.find(s => s.id === c.current.workShop);
      if (shop) workIncome += shop.baseWage * c.traits.workMultiplier;
    }
  });

  const profit = revenue - foodCost - fixedCost;
  const cashChange = profit - familyCost + workIncome;

  return {
    traffic, unitPrice, revenue,
    foodCost, fixedCost, familyCost,
    workIncome, profit, cashChange,
    purchaseMul, kitchenMul, washMul, frontMul,
    repCoeff, priceCoeff, menuTrafficCoeff, menuPriceCoeff,
  };
}

// ============================================================
//   结局
// ============================================================
function checkEnding() {
  if (state.cash < 0) {
    state.bankruptCount++;
    showModal(playScript(STORY.bankrupt));
    document.getElementById('modal-btn').onclick = () => {
      closeModal();
      resetGame();
      switchPage('home');
    };
    return;
  }
  if (state.loan <= 0 && state.totalProfit >= CONFIG.targetProfit) {
    showModal(playScript(STORY.success));
    document.getElementById('modal-btn').onclick = closeModal;
    return;
  }

  generateSpecialCustomers();
  renderPage('home');
  renderStatus();
}

function resetGame() {
  state.week = 1;
  state.cash = CONFIG.startCash;
  state.loan = CONFIG.startLoan;
  state.totalProfit = 0;
  state.reputation = 50;
  state.customers = [];
  state.seenCustomers = [];
  state.ledger = [];
  state.menu = ['rice', 'miso', 'congyou'];
  state.learnedRecipes = [];
  state.lastTraffic = 0;
  state.lastProfit = 0;
  state.purchaseWeeks = 0;
  state.lastPurchaseMul = 0;

  SHOPS.forEach(s => { s.workCount = 0; s.affinity = 0; });

  characters = CHARACTERS.map(createCharacterEntity);
  initHomePositions();
  updateWorkPositions();

  spawnNormalCustomer();
  spawnNormalCustomer();

  renderStatus();
  renderPage('home');
}

function initHomePositions() {
  characters.forEach(c => {
    if (TASK_ZONE[c.current.task] === 'home') {
      assignHomeInitialPosition(c);
    } else if (RESTAURANT_SPOTS[c.current.task]) {
      const spots = RESTAURANT_SPOTS[c.current.task];
      c.current.position = { x: spots[0].x, y: spots[0].y };
    }
  });
}

// ============================================================
//   主循环
// ============================================================
let tickTimer = null;
let lastTick = Date.now();

function startTick() {
  if (tickTimer) return;
  lastTick = Date.now();
  tickTimer = setInterval(() => {
    const now = Date.now();
    const dt = now - lastTick;
    lastTick = now;
    tickUpdate(dt);
  }, 400);
}

function tickUpdate(dt) {
  const active = document.querySelector('.page.active');
  const pageId = active ? active.id : '';

  if (pageId === 'page-home') {
    tickCustomers(dt);
    updateCustomersDOM();
  } else if (pageId === 'page-family') {
    tickHomeChars(dt);
    updateHomeCharsDOM();
  }
}

// ============================================================
//   启动
// ============================================================
function init() {
  state.menu = ['rice', 'miso', 'congyou'];
  initHomePositions();
  updateWorkPositions();

  spawnNormalCustomer();
  spawnNormalCustomer();

  renderStatus();

  const container = document.getElementById('page-container');
  if (container) container.classList.add('no-padding');

  renderPage('home');
  startTick();
}